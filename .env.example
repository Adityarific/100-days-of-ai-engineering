# Copy to .env and fill in your own values. Never commit .env.
# Add only the providers you actually use; every key below is optional.

# Model providers (use free tiers or local models where possible)
OPENAI_API_KEY=
GOOGLE_API_KEY=
ANTHROPIC_API_KEY=
GROQ_API_KEY=

# Day 1 experiment: any OpenAI-compatible endpoint (a local Ollama server needs no key)
# Ollama: http://localhost:11434/v1  |  Groq: https://api.groq.com/openai/v1
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=

# Local models (Day 8 onward)
OLLAMA_BASE_URL=http://localhost:11434

# Tracing (Day 17 onward)
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=100-days-of-ai-engineering

# Project database (Module 4 onward)
DATABASE_URL=

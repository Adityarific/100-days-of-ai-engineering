      "days": [1, 6],
      "goal": "Understand how LLMs behave, what a request costs, where models fail, and how to choose one from measurements instead of rankings."
    },
    {
      "id": 2,
      "slug": "building-with-llm-apis",
      "title": "Building with LLM APIs",
      "days": [7, 17],
      "goal": "Turn single model calls into a reliable app with LangChain: conversations, streaming, structured output, tools, chains, retries, batching and tracing."
    },
    {
      "id": 3,
      "slug": "prompt-engineering",
      "title": "Prompt Engineering",
      "days": [18, 24],
      "goal": "Write, test, version and defend prompts, and choose between prompt versions with numbers instead of gut feel."
    },
    {
      "id": 4,
      "slug": "rag",
      "title": "RAG",
      "days": [25, 56],
      "goal": "Build a retrieval system that cites its sources, improve it with advanced patterns, prove what helped with evals, and secure it."
    },
    {
      "id": 5,
      "slug": "agents",
      "title": "Agents",
      "days": [57, 83],
      "goal": "Build agents with LangGraph, MCP, memory and context control, extend to multi-agent systems, then evaluate and secure them."
    },
    {
      "id": 6,
      "slug": "shipping-to-production",
      "title": "Shipping to Production",
      "days": [84, 100],
      "goal": "Design, deploy, release safely, monitor, cut cost, fine-tune where it pays off, and security-review the whole app."
    }
  ],
